  "relations": {
    "becklin": {
      "groups": [
        {
          "characters": [
            {
              "id": "giacometti",
              "message": {
                "jp": "私とおなじ、スイス出身のミューズの子です。ふらふらしてるけど、ひとりで大丈夫でしょうか…？",
                "en": ""
              }
            }
          ]
        }
      ]
    },
    "boucher": {
      "groups": [
        {
          "characters": [
            {
              "id": "fragonard",
              "message": {
                "jp": "華々しきロココのミューズたちじゃ。ヴァトーは大先輩じゃし、フラゴナールはわらわの弟子なんじゃぞ。",
                "en": ""
              }
            }
          ]
        }
      ]
    },
    "bruegel": {
      "groups": [
        {
          "characters": [
            {
              "id": "bosch",
              "message": {
                "jp": "私とおなじ時期のミューズって、変わった子が多いよね。……私が言うなって？　それはそう！　あはは！",
                "en": ""
              }
            },
            {
              "id": "vaneyck",
              "message": {
                "jp": "",
                "en": ""
              }
            },
            {
              "id": "durer",
              "message": {
                "jp": "",
                "en": ""
              }
            }
          ]
        }
      ]
    },
    "caravaggio": {
      "groups": [
        {
          "characters": [
            {
              "id": "velazquez",
              "message": {
                "jp": "バロックだとぉ！？　俺様の真似じゃねーか！　「カラヴァッジョさまさま様式」に変えろよ！",
                "en": ""
              }
            },
            {
              "id": "rubens",
              "message": {
                "jp": "",
                "en": ""
              }
            },
            {
              "id": "latour",
              "message": {
                "jp": "",
                "en": ""
              }
            },
            {
              "id": "rembrandt",
              "message": {
                "jp": "",
                "en": ""
              }
            }
          ]
        },
        {
          "characters": [
            {
              "id": "michelangelo",
              "message": {
                "jp": "ハッ！　俺様と名前が同じとはよぉ。こいつぁラッキーだ。　もちろん、あっちの方がな。",
                "en": ""
              }
            }
          ]
        }
      ]
    },
    "dali": {
      "groups": [
        {
          "characters": [
            {
              "id": "magritte",
              "message": {
                "jp": "どいつもこいつも、うわっつらばっかり。ダリちゃんこそが真のシュルレアリストよ！",
                "en": ""
              }
            }
          ]
        },
        {
          "characters": [
            {
              "id": "vermeer",
              "message": {
                "jp": "フェルメールが絵を描くところを見られるなら、腕を切り落としたっていいわ！",
                "en": ""
              }
            }
          ]
        }
      ]
    },
    "david": {
      "groups": [
        {
          "characters": [
            {
              "id": "ingres",
              "message": {
                "jp": "新古典主義のミューズであり、わが優秀な弟子たちでもある。フランス美術の未来も明るかろう。",
                "en": "test"
              }
            },
            {
              "id": "gerard",
              "message": {
                "jp": "",
                "en": "test"
              }
            },
            {
              "id": "gros",
              "message": {
                "jp": "",
                "en": "test"
              }
            },
            {
              "id": "girodet",
              "message": {
                "jp": "",
                "en": "test"
              }
            }
          ]
        },
        {
          "characters": [
            {
              "id": "boucher",
              "message": {
