  "relations": {
    "rembrandt": {
      "groups": [
        {
          "characters": [
            {
              "id": "haring",
              "message": {
                "jp": "バロック様式の仲間たち！　バロックって期間が長いから、ミューズは他にも、も～っとたくさんいるんだってさ。",
                "en": "Baroque friends! Since the Baroque period was so long, I hear there are sooo many more muses besides these."
              }
            },
            {
              "id": "gogh",
              "message": {
                "jp": "バロック様式の仲間たち！　バロックって期間が長いから、ミューズは他にも、も～っとたくさんいるんだってさ。",
                "en": "Baroque friends! Since the Baroque period was so long, I hear there are sooo many more muses besides these."
              }
            }
          ]
        },
        {
          "characters": [
            {
              "id": "gogh",
              "message": {
                "jp": "ゴッホもボクとおなじ地方の出身なんだ！　でもネーデルラントの空って、あんなにウネウネしてたかなぁ？",
                "en": "Gogh is from the same region as me! But... was the sky in the Netherlands really that wavy?"
              }
            }
          ]
        }
      ]
    },
